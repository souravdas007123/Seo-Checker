# Copy karke .env banao aur apni values bharo. .env ko kabhi git mein commit mat karo.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=seo.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://seo.example.com
DJANGO_BEHIND_PROXY=1            # nginx/Cloudflare ke peeche ho tabhi
TRUST_X_FORWARDED_FOR=1          # nginx/Cloudflare ke peeche ho tabhi (rate limit sahi IP par lage)
DATABASE_URL=postgres://seo:seo@db:5432/seo

# Core Web Vitals (Google PageSpeed API key)
PAGESPEED_API_KEY=

# Limits
SCAN_DAILY_LIMIT=3
SCAN_DAILY_LIMIT_USER=15
CRAWL_MAX_PAGES=25
ANON_RETENTION_DAYS=30
USER_RETENTION_DAYS=365

# docker-compose ke postgres ke liye
POSTGRES_USER=seo
POSTGRES_PASSWORD=seo
POSTGRES_DB=seo
